    "nombre": "Mamulengo, Cholito.",
    "categoria": "Títere",
    "estado": null,
    "descripcion_corta": {
      "es": "Títere Mamulengo, tradicional de Brasil declarado patrimonio de la humanidad por la UNESCO.",
      "en": "Mamulengo puppet, a traditional Brazilian form declared Intangible Cultural Heritage of Humanity by UNESCO.",
      "fr": "Marionnette Mamulengo, forme traditionnelle brésilienne déclarée Patrimoine Culturel Immatériel de l'Humanité par l'UNESCO.",
      "pt": "Boneco Mamulengo, forma tradicional brasileira declarada Patrimônio Cultural Imaterial da Humanidade pela UNESCO."
    },
    "historia_completa": {
      "es": "Construido por artesanas brasileñas hijas del destacado titiritero Abel Núñez. Fueron construidos especialmente para la exposición.",
      "en": "Built by Brazilian craftswomen, daughters of the renowned puppeteer Abel Núñez. They were crafted especially for this exhibition.",
      "fr": "Construites par des artisanes brésiliennes, filles du célèbre marionnettiste Abel Núñez. Elles ont été créées spécialement pour l'exposition.",
      "pt": "Construído por artesãs brasileiras, filhas do destacado titeriteiro Abel Núñez. Foram construídos especialmente para a exposição."
    },
    "origen": "Brasil",
    "periodo": "2012",
    "creador_artista": "Fenisiana Barbolento",
