# Copy this file to .deploy/.env.deploy and chmod 600.
# Credentials are never committed; FTPS is the secure default.

FTP_PROTOCOL=ftps
FTP_TLS_VERIFY=true
FTP_HOST=int5.cpanelhost.cl
FTP_PORT=21
FTP_USER=your-cpanel-user
FTP_PASS=replace-with-your-password
FTP_REMOTE_DIR=public_html/totem.teatromuseo.cl

# Optional post-deploy smoke test. Leave empty to skip it.
DEPLOY_HEALTHCHECK_URL=https://totem.teatromuseo.cl/health
DEPLOY_HEALTHCHECK_TIMEOUT=20

# Plain FTP or disabled TLS verification require explicit temporary opt-in.
# ALLOW_INSECURE_FTP=false
