#--------------------------------------------------------------------
# Environment Configuration — Teatro Museo Totem
#--------------------------------------------------------------------

# Environment (development, testing, production)
CI_ENVIRONMENT = development

# App Base URL
app.baseURL = 'http://localhost:8186/'
app.forceGlobalSecureRequests = false

# App Key (32-character random string)
# app.key = 'hex2bin:...'

#--------------------------------------------------------------------
# Totem Integration Settings (BFF public-read)
#--------------------------------------------------------------------

# teatromuseo-bff base URL (canonical BFF port is 8188)
TOTEM_BFF_BASE_URL = 'http://localhost:8188'

# X-App-Key sent to the BFF's public-read seam. Must match TOTEM_BFF_API_KEY
# configured on teatromuseo-bff — dedicated to the totem so its access can be
# audited/rotated independently of teatromuseo-web's key.
TOTEM_BFF_API_KEY = 'CHANGE_ME'

# UI Features
TOTEM_ENABLE_TRANSITIONS = true
TOTEM_ENABLE_ANIMATIONS = true

# Offline resilience: `BffTotemClient` caches every BFF response for
# TOTEM_CACHE_TTL_SECONDS ("fresh") and separately keeps the last real
# successful response for TOTEM_STALE_TTL_SECONDS ("stale"), served only
# when the BFF is unreachable or erroring — never invented content.
TOTEM_CACHE_TTL_SECONDS = 60
TOTEM_STALE_TTL_SECONDS = 86400

# Database (stateless app — no database of its own; SQLite in-memory is a safe default)
database.default.DBDriver = 'SQLite3'
database.default.database = ':memory:'

# Encryption Keys (replace with secure random bytes on deploy)
encryption.key = ''
encryption.digest = 'SHA512'
