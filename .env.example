#--------------------------------------------------------------------
# Environment Configuration — Teatro Museo Totem
#--------------------------------------------------------------------

# Environment (development, testing, production)
CI_ENVIRONMENT = development

# App Base URL
app.baseURL = 'http://localhost:8186/'

# App Key (32-character random string)
# app.key = 'hex2bin:...'

# Database (Stateless app — uses SQLite in-memory for testing/session if needed)
# database.tests.DBDriver = 'SQLite3'
# database.tests.database = ':memory:'

#--------------------------------------------------------------------
# Totem Integration Settings (Hub API)
#--------------------------------------------------------------------

# Hub Totem API Base URL (Canonical Hub port is 8180)
TOTEM_API_URL = 'http://localhost:8180/api/v1/totem'

# X-Totem-Key secret key for authenticating with the Hub
TOTEM_API_KEY = 'ttm_dev_secret_key'

# UI Features
TOTEM_ENABLE_TRANSITIONS = true
TOTEM_ENABLE_ANIMATIONS = true

# Offline Caching Resilience
TOTEM_ENABLE_FILE_CACHE = true
TOTEM_CACHE_TTL_SECONDS = 60
