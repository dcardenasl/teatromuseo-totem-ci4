#--------------------------------------------------------------------
# Environment Configuration file for Teatromuseo Tótem Interactivo
#
# Copy this file to .env and customize for your environment.
# All settings are commented out by default. Uncomment to override.
#--------------------------------------------------------------------

#--------------------------------------------------------------------
# ENVIRONMENT
#--------------------------------------------------------------------

# Values: development, testing, production
# CI_ENVIRONMENT = development

#--------------------------------------------------------------------
# APP
#--------------------------------------------------------------------

# Base URL of your application (with trailing slash)
# app.baseURL = 'http://localhost:8186/'
# app.baseURL = 'https://teatromuseo.example.com/'

# Force HTTPS in production
# app.forceGlobalSecureRequests = false

# Content Security Policy (prepare for activation)
# app.CSPEnabled = false

# Timezone (Chile)
# app.appTimezone = 'America/Santiago'

# Default locale
# app.defaultLocale = 'es'
# app.supportedLocales = ['es', 'en', 'fr', 'pt']

#--------------------------------------------------------------------
# DATABASE
# (Not used by tótem currently - API-based application)
#--------------------------------------------------------------------

# database.default.hostname = localhost
# database.default.database = ci4
# database.default.username = root
# database.default.password = root
# database.default.DBDriver = MySQLi
# database.default.DBPrefix =
# database.default.port = 3306

#--------------------------------------------------------------------
# SESSION
#--------------------------------------------------------------------

# session.driver = 'CodeIgniter\Session\Handlers\FileHandler'
# session.savePath = WRITEPATH . 'session'
# session.cookieName = ci_session
# session.expiration = 7200

#--------------------------------------------------------------------
# COOKIE
#--------------------------------------------------------------------

# cookie.prefix = ''
# cookie.expires = 0
# cookie.path = '/'
# cookie.domain = ''
# cookie.secure = false
# cookie.httponly = false
# cookie.samesite = 'Lax'
# cookie.raw = false

#--------------------------------------------------------------------
# LOGGER
#--------------------------------------------------------------------

# Threshold: 0=disabled, 1=debug, 2=info, 3=notice, 4=warning, 5=critical
# logger.threshold = 4

#--------------------------------------------------------------------
# TOTEM BFF CONNECTION
#--------------------------------------------------------------------
# Base URL and app key for teatromuseo-bff's public-read seam.
# TOTEM_BFF_API_KEY must match TOTEM_BFF_API_KEY configured on the BFF.

# TOTEM_BFF_BASE_URL = 'http://localhost:8188'
# TOTEM_BFF_API_KEY = 'your-app-key-here'

#--------------------------------------------------------------------
# TOTEM FEATURE FLAGS
#--------------------------------------------------------------------
# Control visual effects and behaviors of the interactive totem.

# Enable/disable page transition animations (clown nose, curtain, confetti, etc.)
# TOTEM_ENABLE_TRANSITIONS = true

# Enable/disable non-essential animations
# TOTEM_ENABLE_ANIMATIONS = true

# Fresh cache TTL in seconds for BFF responses (default: 60)
# TOTEM_CACHE_TTL_SECONDS = 60

# Stale cache TTL in seconds — the last real response, served only when the
# BFF is unreachable (default: 86400)
# TOTEM_STALE_TTL_SECONDS = 86400

#--------------------------------------------------------------------
# SECURITY
#--------------------------------------------------------------------

# Encryption key (generate with: php -r "echo bin2hex(random_bytes(32));"
# encryption.key = 'your-32-byte-hex-key-here'

# CSRF protection (if enabled in filters)
# security.tokenName = csrf_test_name
# security.headerName = X-CSRF-TOKEN
# security.cookieName = csrf_cookie_name
# security.expires = 7200

#--------------------------------------------------------------------
# CONTENT SECURITY POLICY
# (Uncomment when app.CSPEnabled = true)
#--------------------------------------------------------------------

# csp.reportOnly = false
# csp.defaultSrc = 'self'
# csp.scriptSrc = 'self'
# csp.styleSrc = 'self'
# csp.imageSrc = 'self'
# csp.baseURI = 'self'

#--------------------------------------------------------------------
# CUSTOM TOTEM SETTINGS
#--------------------------------------------------------------------

# Idle timeout in seconds (default: 120 = 2 minutes)
# TOTEM_IDLE_TIMEOUT = 120

# Warning before idle timeout (default: 15 seconds before timeout)
# TOTEM_IDLE_WARNING = 15

#--------------------------------------------------------------------
# DEPLOYMENT (CI/CD)
#--------------------------------------------------------------------
# These are used by .deploy/deploy.py - not loaded by CodeIgniter

# FTP_HOST = 'ftp.example.com'
# FTP_USER = 'username'
# FTP_PASS = 'password'
# FTP_REMOTE_PATH = '/public_html/'
