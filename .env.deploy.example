# Configuración de credenciales FTP para despliegue automático del Tótem
# IMPORTANTE: Copia este archivo como '.env.deploy' y rellena con tus credenciales reales de cPanel.
# NUNCA compartas ni subas '.env.deploy' a repositorios de Git.

FTP_HOST = 'teatromuseo.cl'
FTP_PORT = 21
FTP_USER = 'TU_USUARIO_DE_CPANEL'
FTP_PASS = 'TU_CONTRASEÑA_DE_CPANEL'

# Carpeta de destino del subdominio en el servidor cPanel
# (Suele ser public_html/totem.teatromuseo.cl)
FTP_REMOTE_DIR = 'public_html/totem.teatromuseo.cl'
